generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1.- App User
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

