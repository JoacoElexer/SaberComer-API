# Servidor
PORT=3010
NODE_ENV=development
# Zona horaria de la clínica: define a qué día pertenece cada registro.
APP_TIMEZONE=America/Mexico_City
# Origen(es) del front-end permitidos por CORS, separados por comas.
WEBAPP_URL=
# Saltos de proxy de confianza (en Render: 1). Por defecto 1 en producción.
TRUST_PROXY=

# Base de datos
DATABASE_URL=
# Certificado CA: ruta al archivo (./certs/ca.pem) o el contenido del PEM.
DATABASE_CA_CERT=./certs/ca.pem
DATABASE_POOL_MAX=5
# true para ver las consultas de Prisma en desarrollo (nunca en producción).
PRISMA_LOG_QUERIES=false

# JWT: contenido del PEM en JWT_PRIVATE_KEY / JWT_PUBLIC_KEY,
# o ruta del archivo en *_PATH (por defecto ./certs/jwt-*.pem).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=./certs/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./certs/jwt-public.pem
JWT_EXPIRES_IN=7d

# Milisegundos que /health reutiliza un resultado correcto (por defecto 30000).
HEALTH_CACHE_MS=30000

# Límites de peticiones por IP (opcionales)
RATE_LIMIT_API_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5

# Cuenta dev que crea el seed (npm run db:seed)
SEED_DEV_USUARIO=
SEED_DEV_CORREO=
SEED_DEV_PASSWORD=
